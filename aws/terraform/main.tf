# EventHub on AWS: EC2 web server + EBS data volume + security group
# The server is configured afterwards by Ansible (../ansible/site.yml).

data "aws_caller_identity" "current" {}

data "aws_vpc" "default" {
  default = true
}

# Latest Amazon Linux 2023 image, looked up from AWS's public SSM parameter
data "aws_ssm_parameter" "al2023" {
  name = "/aws/service/ami-amazon-linux-latest/al2023-ami-kernel-default-x86_64"
}

resource "aws_key_pair" "eventhub" {
  key_name   = "eventhub-key"
  public_key = file(pathexpand(var.public_key_path))
}

resource "aws_security_group" "web" {
  name        = "eventhub-web-sg"
  description = "EventHub web server: HTTP from anywhere, SSH for Ansible"
  vpc_id      = data.aws_vpc.default.id

  ingress {
    description = "HTTP"
    from_port   = 80
    to_port     = 80
    protocol    = "tcp"
    cidr_blocks = ["0.0.0.0/0"]
  }

  ingress {
    description = "SSH (Ansible)"
    from_port   = 22
    to_port     = 22
    protocol    = "tcp"
    cidr_blocks = [var.ssh_cidr]
  }

  egress {
    description = "All outbound (package installs, GitHub, CloudWatch, S3)"
    from_port   = 0
    to_port     = 0
    protocol    = "-1"
    cidr_blocks = ["0.0.0.0/0"]
  }
}

resource "aws_instance" "web" {
  ami                    = data.aws_ssm_parameter.al2023.value
  instance_type          = var.instance_type
  key_name               = aws_key_pair.eventhub.key_name
  vpc_security_group_ids = [aws_security_group.web.id]
  iam_instance_profile   = local.instance_profile
  monitoring             = false # basic (free) 5-minute CloudWatch metrics

  root_block_device {
    volume_size = 16
    volume_type = "gp3"
    encrypted   = true
  }

  metadata_options {
    http_tokens = "required" # IMDSv2 only
  }

  tags = {
    Name = "eventhub-web"
  }
}

# Separate EBS volume, mounted by Ansible at /data (local backup staging area)
resource "aws_ebs_volume" "data" {
  availability_zone = aws_instance.web.availability_zone
  size              = 2
  type              = "gp3"
  encrypted         = true

  tags = {
    Name = "eventhub-data"
  }
}

resource "aws_volume_attachment" "data" {
  device_name = "/dev/sdf"
  volume_id   = aws_ebs_volume.data.id
  instance_id = aws_instance.web.id

  # The volume is mounted, so stop the instance before detaching on destroy (avoids a hang)
  stop_instance_before_detaching = true
}

# Ansible inventory written automatically from Terraform outputs
resource "local_file" "inventory" {
  filename        = "${path.module}/../ansible/inventory.ini"
  depends_on      = [aws_volume_attachment.data]
  file_permission = "0644"
  content         = <<-EOT
    # Generated by Terraform - do not edit by hand
    [web]
    ${aws_instance.web.public_ip} ansible_user=ec2-user ansible_ssh_private_key_file=${var.private_key_path}

    [web:vars]
    aws_region=${var.region}
    backup_bucket=${aws_s3_bucket.backup.bucket}
    repo_url=${var.repo_url}
  EOT
}
